# Copy to .env and adjust as needed. All values are optional — sensible
# defaults are baked into server/config.js.

# HTTP port the dashboard (and its WebSocket) is served on.
PORT=5173

# Folder the backend watches for new/changed .xlsx or .csv files.
# Defaults to <project>/data/incoming.
INCOMING_DIR=./data/incoming

# How long (ms) a watched file's size must stay unchanged before it is
# treated as "done writing" and ingested. Also acts as the debounce window
# for editors/Excel that write in several small steps.
WATCH_STABILITY_MS=3000
WATCH_POLL_MS=300
